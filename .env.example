# --- Banco de dados ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tasks
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Execução local (fora do Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tasks
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tasks_test

# --- Jenkins (docker compose up) ---
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=admin
# No Linux: stat -c %g /var/run/docker.sock
DOCKER_GID=0
GIT_REPO_URL=https://github.com/ImHenriqueCampello/TaskAPI.git

# --- Docker Hub ---
DOCKERHUB_REPO=joaolucenalima/taskapi
DOCKERHUB_USERNAME=seu-usuario
DOCKERHUB_TOKEN=seu-token-de-acesso

# --- Notificação por e-mail (nunca fixar no código) ---
NOTIFY_EMAIL=destinatario@exemplo.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=remetente@gmail.com
SMTP_PASSWORD=senha-de-app
SMTP_FROM=remetente@gmail.com
